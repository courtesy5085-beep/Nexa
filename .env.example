# ──────────────────────────────────────────────
# Nexa — Environment Variables
# Copy to .env (local) or paste as TOML into Streamlit Cloud → Secrets
# ──────────────────────────────────────────────

# --- App ---
APP_URL=http://localhost:8501
APP_OWNER_EMAIL=you@example.com          # this email gets /admin access

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_KEY=eyJhbGciOi...       # server-only, keep secret

# --- Google OAuth (Gmail sign-in) ---
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_REDIRECT_URI=http://localhost:8501

# --- SMTP for OTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx            # Gmail App Password
SMTP_FROM=Nexa <you@gmail.com>

# --- LLM Provider (pick one) ---
LLM_PROVIDER=openai                      # openai | anthropic | lovable
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
LOVABLE_API_KEY=                         # if LLM_PROVIDER=lovable
LOVABLE_MODEL=google/gemini-3-flash-preview

# --- Embeddings (for RAG) ---
EMBEDDING_MODEL=text-embedding-3-small   # 1536 dims — matches schema

# --- Real-time web search ---
TAVILY_API_KEY=tvly-...

# --- Rate limiting ---
RATE_LIMIT_PER_10MIN=30

# --- Session ---
SESSION_SECRET=change-me-to-a-long-random-string
